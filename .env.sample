# Integrated chat configuration
# Active LLM provider: Google Gemini (see src/features/chat/server/gemini.ts).
# Safeguard is baked into the system instruction; each query is a single call.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# [INACTIVE] Groq provider (see src/features/chat/server/server.ts).
# Retained for reference / potential re-activation; not used by the live pipeline.
GROQ_API_KEY=
MODEL=llama-3.3-70b-versatile
SAFEGUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_RATE_LIMIT=50
GLOBAL_RATE_LIMIT=1000
RATE_LIMIT_TIMEZONE=UTC
GUEST_SECRET=replace-with-a-long-random-secret
MAX_REQUEST_SIZE=1048576

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-a-long-random-secret

# Optional GitHub sync for src/data persistence
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_PROJECTS_FILE=src/data/projects.json
GITHUB_CONTACT_FILE=src/data/contact.json

# Optional admin database
DATABASE_URL=
