# Integrated chat configuration
# Active LLM provider: Google Gemini (see src/features/chat/server/gemini.ts).
# Safeguard is baked into the system instruction; each query is a single call.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# [INACTIVE] Groq provider (see src/features/chat/server/server.ts).
# Retained for reference / potential re-activation; not used by the live pipeline.
GROQ_API_KEY=
MODEL=llama-3.3-70b-versatile
SAFEGUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Redis rate limiting (chat). Chat requires these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_RATE_LIMIT=30
GLOBAL_RATE_LIMIT=500
RATE_LIMIT_TIMEZONE=UTC
GUEST_SECRET=replace-with-a-long-random-secret
MAX_REQUEST_SIZE=1048576

# Contact form (Web3Forms — https://web3forms.com). The access key is public by
# design and is read client-side, so it MUST use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
